# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_OWNER_ID=
# Set in production to use a webhook, e.g. https://<app>.fly.dev/webhook.
# Leave empty locally to use long polling (use a separate dev bot token).
TELEGRAM_WEBHOOK_URL=
PORT=8080

# Gmail (OAuth app set to "In production", scope gmail.modify)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Lunch Money v2
LUNCHMONEY_TOKEN=
LUNCHMONEY_ACCOUNT_ID=   # Monthly Budget

# LLM: "cli" uses `claude -p` with your Pro subscription; "api" uses an API key
LLM_MODE=cli
CLAUDE_CODE_OAUTH_TOKEN= # from `claude setup-token`
ANTHROPIC_API_KEY=       # only when LLM_MODE=api

# Jev
JEV_API_KEY=
JEV_CONFIDENCE_THRESHOLD=0.85

# Storage: /data/expense.db on Fly (the volume); use ./expense.db locally
DATABASE_PATH=/data/expense.db

# Logging (tracing filter syntax)
RUST_LOG=info
